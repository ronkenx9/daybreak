# Optional: server-only Base mainnet RPC. Defaults to the public Base RPC.
# BASE_RPC_URL=https://your-base-rpc-provider.example
# X Layer (chain 196): xStocks reads and the Daybreak conviction vault.
# XLAYER_RPC_URL=https://rpc.xlayer.tech
# NEXT_PUBLIC_XLAYER_VAULT_ADDRESS=0x55318F36f5B482e9F2b1429f2Ca7fD7c5BBf97fc   # live vault (contracts/deployments/xlayer.json)

# Optional: enable accounts. Configure allowed origins and login methods in Privy.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# Supabase pooled Postgres connection string for account persistence (server-only).
# Copy this from Supabase Dashboard → Connect. Transaction pooler is supported.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# GDELT company news and Dexscreener discovery need no API key.

# Server-only Definitive Flash integrator key. Required to show and submit stock orders.
# Create at https://app.definitive.fi/ (More → Flash → Create Flash Key).
# DEFINITIVE_FLASH_API_KEY=dpka_...

# Bankr integration (server-only; leave unset to keep the integration inert)
# BANKR_API_KEY=bk_usr_...        # user-key mode
# BANKR_PARTNER_KEY=bk_ptr_...    # partner/org mode (Base-only, feeRecipient required)
# BANKR_API_BASE=https://api.bankr.bot
# Optional Bankr LLM Gateway key with LLM permission for Daybreak Research Desk.
# Falls back to BANKR_API_KEY; no key or inaccessible model disables the desk.
# BANKR_LLM_KEY=bk_...
# BANKR_RESEARCH_MODEL=gemini-3-flash

# Comma-separated Privy DIDs allowed to resolve Credit refunds and Circle disputes.
# Leave unset to fail closed. See docs/DAYBREAK-ECONOMICS.md for operator steps.
# DAYBREAK_ECONOMY_ADMIN_DIDS=did:privy:...

# Circle Gateway x402 seller address. Required to activate the paid pairing-data API.
# This is a public EVM address that receives Gateway USDC; never put a private key here.
# DAYBREAK_X402_SELLER_ADDRESS=0x...
