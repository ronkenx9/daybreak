{
  "name": "dayworld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit && node -e \"console.log('dayworld typecheck passed')\"",
    "imessage:dev": "npm --prefix services/daybreak-imessage run dev",
    "imessage:test": "npm --prefix services/daybreak-imessage test",
    "imessage:build": "npm --prefix services/daybreak-imessage run build",
    "test": "node scripts/audit-core.cjs",
    "test:agent-api": "node scripts/test-agent-api-behavior.cjs && node scripts/test-agent-api-database.cjs && node scripts/verify-agent-api.mjs",
    "example:paper-agent": "node examples/paper-agent/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "node --env-file-if-exists=.env.local scripts/db-preflight.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:verify": "node --env-file-if-exists=.env.local scripts/db-verify.mjs",
    "db:verify-economy": "node --env-file-if-exists=.env.local scripts/db-verify-economy.mjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.10",
    "@circle-fin/x402-batching": "^3.4.0",
    "@coinbase/wallet-sdk": "^4.3.7",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.12",
    "@privy-io/react-auth": "^3.40.0",
    "@privy-io/server-auth": "^1.32.5",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/web3.js": "^1.99.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "@x402/evm": "^2.25.0",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.4",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.172.0",
    "viem": "^2.22.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.172.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "axios": "^1.18.0"
  }
}
